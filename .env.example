# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en wordt nooit gecommit.
# Waarden vind je in Supabase onder Project Settings > API Keys.

# De url van je Supabase-project.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# De publishable key (begint met sb_publishable_). Deze mag publiek zijn:
# hij geeft alleen toegang tot wat de RLS-policies toestaan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
