# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en wordt nooit gecommit.
# Waarden vind je in Supabase onder Project Settings > API Keys.

# Publiek: de url van je Supabase-project.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Geheim: omzeilt Row Level Security. Alleen op de server gebruiken,
# dus nooit met een NEXT_PUBLIC_-prefix.
SUPABASE_SECRET_KEY="sb_secret_..."
